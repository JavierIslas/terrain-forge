# La distribución oficial se arma con pack.sh (AGPL + commercial, mismo código).
# El "Download ZIP" desde GitHub no debe entregar un paquete usable: se excluye
# todo lo que no es el addon en sí.
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
test/ export-ignore
addons/gdUnit4/ export-ignore
addons/hex_strategy_map/ export-ignore
README.md export-ignore
LICENSE export-ignore
LICENSE_COMMERCIAL.md export-ignore
llms.txt export-ignore
pack.sh export-ignore
project.godot export-ignore
icon.svg export-ignore
icon.svg.import export-ignore

# Line endings: LF en todo el texto del repo (Godot escribe LF en todas las
# plataformas; evita diffs ruidosos y archivos mixtos si entra contribuidores
# desde Windows).
* text=auto eol=lf
*.png binary
*.zip binary
# Vendor de terceros intacto: sin conversión de line endings en su contenido
# (gdUnit4 trae un .tscn con finales mixtos que no nos toca renormalizar).
addons/gdUnit4/** -text
addons/hex_strategy_map/** -text
